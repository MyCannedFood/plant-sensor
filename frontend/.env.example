# Where `npm run dev` forwards /api and /sanctum requests (the Laravel server).
VITE_BACKEND_URL=http://localhost:8000

# Base URL the built app calls. Leave empty when the dashboard and the API are
# served from the same origin (e.g. behind one Nginx). Set it to the API's
# origin, e.g. https://api.example.com, when they live on different subdomains.
VITE_API_URL=

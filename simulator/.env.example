# Simulator defaults
SIMULATOR_DEFAULT_INTERVAL=10
SIMULATOR_DEFAULT_VARIANCE=0.15

# API Configuration
SIMULATOR_API_URL=http://localhost          # Base URL without /api (e.g., https://api.example.com)
SIMULATOR_TOKEN_FILE=../backend/storage/app/private/device-tokens.json
SIMULATOR_VERIFY_SSL=true

# WebSocket (optional, for real-time updates)
SIMULATOR_WS_URL=ws://localhost             # e.g., wss://api.example.com/ws

# Logging
SIMULATOR_LOG_LEVEL=INFO